  "preguntasRefugio": [
    { "refugio": "ref-1", "pregunta": "¿Qué documentos necesito para adoptar?", "claves": ["requisitos", "papeles", "documentacion"],
      "respuesta": "Necesitamos tu identificación oficial vigente (INE o pasaporte), un comprobante de domicilio y de 1 a 3 fotos del espacio donde vivirá la mascota. Puedes subirlos en PDF, JPG o PNG." },
    { "refugio": "ref-1", "pregunta": "¿Qué comprobantes de domicilio aceptan?", "claves": ["recibo", "luz", "agua", "predial", "antiguedad"],
      "respuesta": "Aceptamos recibo de luz, agua, teléfono, internet o predial a tu nombre o de un familiar directo, con una antigüedad máxima de 3 meses." },
    { "refugio": "ref-1", "pregunta": "¿Cómo deben ser las fotos del espacio?", "claves": ["fotos", "patio", "casa", "departamento", "imagenes"],
      "respuesta": "Toma fotos claras de las áreas donde estará la mascota: patio, jardín, azotea o interior. Si vives en departamento, incluye una foto de las ventanas o del balcón con protección." },
    { "refugio": "ref-1", "pregunta": "¿Puedo adoptar si rento mi vivienda?", "claves": ["renta", "rentada", "arrendador", "casero"],
      "respuesta": "Sí. Solo te pediremos que confirmes que en tu contrato de renta se permiten mascotas; si no estás seguro, pregúntale a tu arrendador antes de enviar la solicitud." },
    { "refugio": "ref-1", "pregunta": "¿Cuánto tarda la revisión de mi solicitud?", "claves": ["tiempo", "cuando", "respuesta", "dias", "tarda"],
      "respuesta": "Revisamos las solicitudes en un máximo de 5 días hábiles. Si todo está en orden te llamaremos para agendar una entrevista y una visita para conocer a la mascota." },
    { "refugio": "ref-1", "pregunta": "¿La adopción tiene algún costo?", "claves": ["costo", "precio", "pagar", "cuota", "donativo"],
      "respuesta": "La adopción no tiene costo. Al entregar la mascota pedimos un donativo voluntario que nos ayuda a cubrir vacunas y esterilizaciones de otros animales." },
    { "refugio": "ref-2", "pregunta": "¿Qué necesito para adoptar en PetCare?", "claves": ["requisitos", "documentos", "papeles"],
      "respuesta": "Identificación oficial, comprobante de domicilio reciente y fotos del lugar donde vivirá la mascota. Además, todos los adultos de la casa deben estar de acuerdo con la adopción." }
  ],
