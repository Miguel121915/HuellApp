# Copia este archivo como ".env" (en esta misma carpeta) y llena tus datos.
# NUNCA subas el .env al repositorio: tiene contraseñas.

# --- Base de datos: Oracle Autonomous Database en OCI (ver la guía de Oracle) ---
# Nombre del servicio, tal como aparece en el tnsnames.ora del wallet
DB_TNS=huellapp_tp
DB_USER=HUELLAPP_DEV
DB_PASS=
# Reutilizar la conexión con Oracle entre peticiones (1 = sí, mucho más rápido; 0 = no)
DB_PERSISTENTE=1
# Carpeta del wallet. Si ya creaste la variable de entorno TNS_ADMIN en Windows, déjalo comentado.
# TNS_ADMIN=C:\oracle\wallet_huellapp

# Esquema aparte para "php artisan test" (se BORRA en cada prueba; nunca uses DEV ni DEMO aquí)
# DB_TEST_USER=HUELLAPP_TEST
# DB_TEST_PASS=

# --- Servidor (php artisan serve) ---
APP_HOST=127.0.0.1
APP_PORT=3000

# Clave con la que se firman las sesiones. CÁMBIALA si algún día publicas el servidor.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# «Continuar con Google»: ID de cliente de OAuth tipo "Aplicación web" de Google Cloud (ver README, sección 5).
# Vacío = no se muestra el botón de Google. La verificación en dos pasos (Google Authenticator) funciona sin esto.
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# IA de Google (Gemini) para Reportar y Coincidencias: analiza la foto y compara fotos de mascotas.
# Clave gratis en https://aistudio.google.com/apikey . Vacío = sin IA (se compara la descripción y la zona).
# GEMINI_API_KEY=
# Modelo (opcional; por defecto gemini-3.8-flash, el mismo que usaba el servidor Node)
# GEMINI_MODEL=

# Carpeta del sitio web que el servidor también muestra (por defecto ../sitio-web)
# WEB_DIR=../sitio-web

# Orígenes extra permitidos para llamar a la API desde otro sitio (localhost ya está permitido)
# ORIGENES_PERMITIDOS=http://192.168.1.50:5500
