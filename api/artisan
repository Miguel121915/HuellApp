    Semilla::sembrar();
    echo "[OK] Datos cargados. Todas las cuentas demo usan la contrasena: Demo1234\n";
    echo "     ana@huellapp.mx (usuario) | refugio@huellapp.mx (refugio verificado) | admin@huellapp.mx (administrador)\n";
}

