        __DIR__,
        array_merge(getenv(), $entornoPrueba),
    );
    if (!is_resource($servidor)) {
        salir('No se pudo iniciar el servidor de pruebas.');
    }
    $contexto = stream_context_create(['http' => ['timeout' => 1, 'ignore_errors' => true]]);
    for ($i = 0, $listo = false; $i < 40 && !$listo; $i++) {
        $listo = @file_get_contents("http://127.0.0.1:$puerto/api/salud", false, $contexto) !== false;
        $listo || usleep(250000);
    }
    if (!$listo) {
        proc_terminate($servidor);
        salir("El servidor de pruebas no respondio. Revisa $bitacora");
    }

    $pruebas = proc_open(
        ['node', '--test', 'pruebas/api.test.js'],
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $tuberias2,
