#!/usr/bin/env php
<?php
/**
 * artisan — Comandos de HuellApp desde la terminal (mismo estilo que el artisan de Laravel).
 *
 * AVISO: es un script propio y sencillo de este proyecto; NO es Laravel.
 *
 *   php artisan serve                 Enciende el servidor (http://localhost:3000)
 *   php artisan migrate [--seed]      Crea la base de datos y las tablas (y carga datos demo)
 *   php artisan migrate:fresh [--seed] Borra TODO y vuelve a crear las tablas
 *   php artisan db:seed [--force]     Carga los datos de demostración
 *   php artisan refugios ...          Lista y revisa refugios (aprobar, rechazar, suspender, reactivar)
 *   php artisan 2fa:reiniciar correo  Quita la verificación en dos pasos de una cuenta (vuelve a pedir el QR)
 *   php artisan test                  Ejecuta las pruebas automáticas (necesita Node.js)
 */
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    exit('Este archivo se ejecuta desde la terminal:  php artisan');
}
if (PHP_VERSION_ID < 80100) {
    fwrite(STDERR, 'HuellApp necesita PHP 8.1 o superior (tienes ' . PHP_VERSION . "). Actualiza XAMPP.\n");
    exit(1);
}
if (!extension_loaded('pdo_oci')) {
    fwrite(STDERR, "Falta la extension pdo_oci de PHP. En XAMPP: abre php.ini y agrega la linea  extension=pdo_oci  (ver la guia de Oracle).\n");
    exit(1);
}
if (PHP_OS_FAMILY === 'Windows') {
    @exec('chcp 65001 > nul'); // para que los acentos se vean bien en la terminal de Windows
}

require __DIR__ . '/src/bootstrap.php';

use HuellApp\{Base, Config, ErrorHttp, Migraciones, Semilla};

/* ---------- Utilidades ---------- */

function salir(string $mensaje, int $codigo = 1): never
{
    fwrite(STDERR, "\n[ERROR] $mensaje\n\n");
    exit($codigo);
}

/** Ejecuta algo que usa la base de datos y muestra los errores de conexión de forma clara. */
function conBase(callable $fn): mixed
{
    try {
        return $fn();
    } catch (ErrorHttp $e) {
        salir($e->getMessage());
    } catch (PDOException $e) {
        salir('Error de base de datos: ' . $e->getMessage());
    }
}

function opcion(array $args, string $nombre, ?string $defecto = null): ?string
{
    foreach ($args as $a) {
        if (str_starts_with($a, "--$nombre=")) {
            return substr($a, strlen($nombre) + 3);
        }
    }
    return $defecto;
}

function bandera(array $args, string ...$nombres): bool
{
    foreach ($nombres as $n) {
        if (in_array("--$n", $args, true)) {
            return true;
        }
    }
    return false;
}

function confirmar(string $pregunta, array $args): bool
{
    if (bandera($args, 'si', 'force')) {
        return true;
    }
    echo "$pregunta Escribe SI para continuar: ";
    return strtoupper(trim((string) fgets(STDIN))) === 'SI';
}

