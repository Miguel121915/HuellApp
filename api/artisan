function cmdMigrate(array $args): void
{
    conBase(static function () use ($args): void {
        Migraciones::migrar();
        echo '[OK] Tablas listas en el esquema ' . Base::nombreBase() . " de Oracle.\n";
        if (bandera($args, 'seed')) {
            if (Migraciones::baseVacia()) {
                sembrarDemo();
            } else {
                echo "La base ya tiene datos: no se cargo la demostracion (usa migrate:fresh --seed para empezar de cero).\n";
            }
        }
    });
}

function cmdMigrateFresh(array $args): void
{
    if (!confirmar('Esto BORRA todas las tablas y datos del esquema ' . Base::nombreBase() . ' en Oracle.', $args)) {
        echo "Cancelado. No se borro nada.\n";
        return;
    }
    conBase(static function () use ($args): void {
        Migraciones::reiniciar();
        foreach (['imagenes', 'documentos'] as $carpeta) {
            foreach (glob(Config::dirUploads() . "/$carpeta/*") ?: [] as $archivo) {
                if (is_file($archivo) && basename($archivo) !== '.gitkeep') {
                    @unlink($archivo); // fotos y documentos subidos
                }
            }
        }
        echo "[OK] Tablas recreadas desde cero.\n";
        if (bandera($args, 'seed')) {
            sembrarDemo();
        }
    });
}

function cmdSeed(array $args): void
{
    conBase(static function () use ($args): void {
        if (!Migraciones::tablasExisten()) {
            salir('Todavia no existen las tablas. Ejecuta primero:  php artisan migrate');
        }
        if (!Migraciones::baseVacia() && !bandera($args, 'force')) {
            salir('La base ya tiene datos. Para empezar de cero usa:  php artisan migrate:fresh --seed');
        }
        sembrarDemo();
    });
}

function cmdServe(array $args): void
{
    $host = opcion($args, 'host', Config::obtener('APP_HOST')) ?: '127.0.0.1';
    $puerto = opcion($args, 'port', Config::obtener('APP_PORT')) ?: '3000';

    conBase(static function (): void {
        Migraciones::migrar(); // si falta algo, se crea (es seguro repetirlo)
        if (Migraciones::baseVacia()) {
            echo "Base de datos nueva.\n";
            sembrarDemo();
        }
    });

    $web = Config::dirWeb();
    $hayWeb = is_dir($web);
    echo "\nHuellApp lista en http://$host:$puerto\n";
    echo '  Base de datos: esquema ' . Base::nombreBase() . ' en Oracle (servicio ' . Config::obtener('DB_TNS') . ")\n";
    echo $hayWeb ? "  Sitio web:     http://$host:$puerto  (carpeta $web)\n" : "  Sitio web:     no se encontro $web (usa tu propio servidor, ej. Live Server)\n";
    echo "  Para detenerlo: Ctrl + C\n\n";

    $proceso = proc_open(
        [PHP_BINARY, '-d', 'memory_limit=512M', '-d', 'post_max_size=40M', '-d', 'upload_max_filesize=40M',
            '-S', "$host:$puerto", '-t', $hayWeb ? $web : __DIR__ . '/public', __DIR__ . '/public/index.php'],
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $tuberias,
    );
    if (!is_resource($proceso)) {
        salir('No se pudo iniciar el servidor.');
    }
    calentarConexion($host, $puerto);
    exit(proc_close($proceso));
}

/**
 * Abre la conexión con Oracle en cuanto arranca el servidor (tarda varios segundos la primera vez).
 * Así esa espera pasa aquí y no en la primera pantalla que abra alguien en la app o en la web.
 */
function calentarConexion(string $host, string $puerto): void
{
    $destino = $host === '0.0.0.0' ? '127.0.0.1' : $host;
    for ($i = 0; $i < 50; $i++) { // espera hasta 5 s a que el servidor escuche
        $prueba = @fsockopen($destino, (int) $puerto, $errno, $errstr, 0.2);
        if ($prueba) {
            fclose($prueba);
            break;
        }
        usleep(100000);
    }
    echo "  Conectando con Oracle...\n";
    $inicio = microtime(true);
    $contexto = stream_context_create(['http' => ['timeout' => 90, 'ignore_errors' => true]]);
    $respuesta = @file_get_contents("http://$destino:$puerto/api/salud?db=1", false, $contexto);
    $segundos = number_format(microtime(true) - $inicio, 1);
    $datos = is_string($respuesta) ? json_decode($respuesta, true) : null;
    echo ($datos['baseDeDatos'] ?? false)
        ? "  [OK] Conexion con Oracle lista en {$segundos} s. Ya puedes abrir la app y el sitio.\n\n"
        : "  [Aviso] No se pudo abrir la conexion con Oracle todavia; se intentara en la primera peticion.\n\n";
}

function cmdRefugios(array $args): void
{
    $accion = $args[0] ?? 'listar';
    conBase(static function () use ($accion, $args): void {
        if ($accion === 'listar') {
            $filas = Base::todos('SELECT r.id, r.nombre, r.estado, u.correo FROM refugios r JOIN usuarios u ON u.id = r.usuario_id ORDER BY r.id');
            printf("\n%-4s %-38s %-11s %s\n", 'ID', 'REFUGIO', 'ESTADO', 'CORREO');
            foreach ($filas as $f) {
                printf("%-4s %-38s %-11s %s\n", $f['id'], substr($f['nombre'], 0, 36), $f['estado'], $f['correo']);
            }
            echo "\n";
            return;
        }
        $destinos = ['aprobar' => ['aprobado', ['pendiente']], 'rechazar' => ['rechazado', ['pendiente']], 'suspender' => ['suspendido', ['aprobado']], 'reactivar' => ['aprobado', ['suspendido']]];
        $correo = $args[1] ?? '';
        if (!isset($destinos[$accion]) || $correo === '') {
            salir("Uso:  php artisan refugios <aprobar|rechazar|suspender|reactivar> correo@refugio.com [motivo]\n       php artisan refugios            (para listar)");
        }
        [$nuevo, $origenes] = $destinos[$accion];
        $refugio = Base::uno('SELECT r.id, r.nombre, r.estado FROM refugios r JOIN usuarios u ON u.id = r.usuario_id WHERE u.correo = ?', [strtolower($correo)]);
        if ($refugio === null) {
            salir("No hay ningun refugio con el correo $correo.");
        }
        if (!in_array($refugio['estado'], $origenes, true)) {
            salir("«{$refugio['nombre']}» esta {$refugio['estado']}; no se puede $accion.");
        }
        $motivo = trim(implode(' ', array_slice($args, 2)));
        if ($accion === 'rechazar' && \HuellApp\Validar::largo($motivo) < 10) {
            salir('Escribe un motivo de al menos 10 caracteres (entre comillas).');
        }
        Base::ejecutar(
            'UPDATE refugios SET estado = ?, motivo_rechazo = ?, revisado_en = ? WHERE id = ?',
            [$nuevo, in_array($accion, ['aprobar', 'reactivar'], true) ? '' : $motivo, Base::ahora(), $refugio['id']],
        );
        echo "[OK] «{$refugio['nombre']}» ahora esta $nuevo.\n";
    });
}

