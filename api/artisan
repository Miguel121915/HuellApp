/**
 * IA de los reportes en segundo plano. La API lo lanza sola al publicar un reporte (con su id) y cuando
 * hay reportes esperando un reintento (sin id: atiende todos los que ya toca).
 *   php artisan ia:procesar [id]
 */
function cmdIaProcesar(array $args): void
{
    conBase(static function () use ($args): void {
        $ids = isset($args[0]) && ctype_digit($args[0]) ? [(int) $args[0]] : \HuellApp\Rutas\Reportes::pendientesIa();
        foreach ($ids as $id) {
            $resultado = \HuellApp\Rutas\Reportes::procesarIa($id);
            echo "Reporte $id: $resultado\n";
        }
        if ($ids === []) {
            echo "No hay reportes esperando a la IA.\n";
        }
    });
}

