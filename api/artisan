        Semilla::sembrar();
    });

    $puerto = 3999;
    $bitacora = sys_get_temp_dir() . DIRECTORY_SEPARATOR . 'huellapp-pruebas-servidor.log';
    $servidor = proc_open(
        [PHP_BINARY, '-S', "127.0.0.1:$puerto", '-t', __DIR__ . '/public', __DIR__ . '/public/index.php'],
        [0 => ['pipe', 'r'], 1 => ['file', $bitacora, 'w'], 2 => ['file', $bitacora, 'a']],
